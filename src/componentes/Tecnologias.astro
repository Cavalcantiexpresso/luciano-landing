---
import Card from "./Card.astro";

const frontend = [
  { name: "Angular", icon: "mdi:angular" },
  { name: "React", icon: "mdi:react" },
  { name: "TypeScript", icon: "mdi:language-typescript" },
  { name: "JavaScript", icon: "mdi:language-javascript" },
  { name: "HTML5", icon: "mdi:language-html5" },
  { name: "CSS3 / SCSS", icon: "mdi:language-css3" },
];

const backend = [
  { name: "Java", icon: "mdi:language-java" },
  { name: "Node.js", icon: "mdi:nodejs" },
  { name: "Express", icon: "mdi:server" },
  { name: "Swagger (OpenAPI)", icon: "mdi:api" },
  { name: "Maven", icon: "mdi:package-variant-closed" },
];

const database = [
  { name: "SQL", icon: "mdi:database" },
  { name: "MongoDB", icon: "mdi:leaf" },
];

const tools = [
  { name: "Figma", icon: "simple-icons:figma" },
  { name: "Git & GitHub", icon: "simple-icons:github" },
  { name: "SCRUM", icon: "mdi:account-group" },
  { name: "Kanban", icon: "mdi:trello" },
  { name: "TDD", icon: "mdi:test-tube" },
  { name: "Pair Programming", icon: "mdi:account-multiple" },
];

const mobile = [
  { name: "React Native", icon: "mdi:react" },
];

const security = [
  { name: "API Security Fundamentals", icon: "mdi:shield-lock" },
  { name: "OWASP Top 10 (Web & API)", icon: "mdi:alert-octagon" },
  { name: "JWT & Auth Tokens", icon: "mdi:key-variant" },
  { name: "Segurança em APIs REST", icon: "mdi:api" },
  { name: "Validação e Controle de Acesso", icon: "mdi:shield-check" },
  { name: "OpenAPI Security", icon: "mdi:file-lock" },
];
---

<section class="tech-section" id="tecnologias">
  <header class="tech-header">
    <h2>Stack Tecnológica</h2>
    <p>
      Tecnologias utilizadas em projetos reais, ambientes corporativos e
      sistemas de produção, com foco em qualidade, escalabilidade e
      manutenibilidade.
    </p>
  </header>

  <div class="card-grid">
    <Card title="Frontend" items={frontend} />
    <Card title="Backend" items={backend} />
    <Card title="Banco de Dados" items={database} />
    <Card title="Ferramentas & Metodologias" items={tools} />
    <Card title="Mobile & Híbrido" items={mobile} />
    <Card title="Security" items={security} />
  </div>
</section>

<style>
  .tech-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1rem;
  }

  .tech-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .tech-header h2 {
    font-size: 2.2rem;
    color: #ffffff;
  }

  .tech-header p {
    max-width: 780px;
    margin: 1rem auto 0;
    opacity: 0.85;
    color: #cbd5e1;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }
</style>