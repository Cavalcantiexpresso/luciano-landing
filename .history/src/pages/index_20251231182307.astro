---

---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Luciano — Desenvolvedor Full Stack</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      :root {
        --bg: #0b0f1a;
        --fg: #e7edf7;
        --muted: #9fb2c8;
        --accent: #4f7cff;
      }
      body {
        margin: 0;
        font-family: Inter, system-ui, sans-serif;
        background: var(--bg);
        color: var(--fg);
      }
      .container {
        max-width: 960px;
        margin: 0 auto;
        padding: 2rem;
      }
      .hero {
        text-align: center;
        padding: 5rem 2rem;
      }
      .hero h1 {
        font-size: 3rem;
        margin-bottom: 1rem;
      }
      .hero p {
        font-size: 1.25rem;
        color: var(--muted);
      }
      .btn {
        display: inline-block;
        background: var(--accent);
        color: white;
        padding: 0.75rem 1.25rem;
        border-radius: 0.5rem;
        text-decoration: none;
        font-weight: 600;
        margin-top: 1.5rem;
      }
      section {
        margin: 4rem 0;
      }
      h2 {
        margin-bottom: 1rem;
        border-left: 4px solid var(--accent);
        padding-left: 0.5rem;
      }
      .card {
        background: #141b2d;
        padding: 1.5rem;
        border-radius: 0.75rem;
        margin-bottom: 1rem;
      }
      ul {
        list-style: none;
        padding: 0;
      }
      ul li {
        margin-bottom: 0.5rem;
      }
      footer {
        text-align: center;
        padding: 2rem;
        color: var(--muted);
        border-top: 1px solid #1f263a;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <!-- Hero -->
      <section class="hero">
        <h1>Luciano Cavalcanti</h1>
        <p>
          Desenvolvedor Full Stack | Angular • Java • Node.js • REST APIs • Git
          • SCRUM
        </p>
        <a
          class="btn"
          href="https://www.linkedin.com/in/lucianocavalcanti/"
          target="_blank">Meu LinkedIn</a
        >
      </section>

      <!-- Sobre -->
      <section>
        <h2>Sobre mim</h2>
        <div class="card">
          <p>
            Sou desenvolvedor com experiência prática em Angular e Node.js,
            integrando sistemas via APIs REST e aplicando boas práticas de
            versionamento e métodos ágeis.
          </p>
        </div>
      </section>

      <!-- Experiência -->
      <section>
        <h2>Experiência</h2>
        <div class="card">
          <strong>BB Tecnologia / Banco do Brasil</strong>
          <p>
            Modernização de sistemas, testes automatizados, integração via APIs,
            práticas ágeis.
          </p>
        </div>
        <div class="card">
          <strong>Paz Church (Voluntariado)</strong>
          <p>Liderança de grupo, técnico de som e imagem, músico (violão).</p>
        </div>
      </section>

      <!-- Habilidades -->
      <section>
        <h2>Habilidades</h2>
        <div class="card">
          <ul>
            <li>Angular</li>
            <li>Java</li>
            <li>Node.js</li>
            <li>REST APIs</li>
            <li>Git & SCRUM</li>
          </ul>
        </div>
      </section>

      <!-- Contato -->
      <section>
        <h2>Contato</h2>
        <div class="card">
          <p>Email: voce@exemplo.com</p>
          <p>
            LinkedIn: <a
              href="https://www.linkedin.com/in/lucianocavalcanti/"
              target="_blank">linkedin.com/in/lucianocavalcanti</a>
          </p>
          <p>GitHub: github.com/seuusuario</p>
        </div>
      </section>
    </div>

    <footer>
      © {new Date().getFullYear()} Luciano — Todos os direitos reservados.
    </footer>
  </body>
</html>
