---

import { Icon } from "astro-icon/components";

const { title, items } = Astro.props;
---

<div class="card">
  <h3 class="card-title">{title}</h3>
  <ul class="card-list">
    {items.map((tech) => (
      <li class="card-item">
        <Icon name={tech.icon} size="24" class="card-icon" />
        <span>{tech.name}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .card {
    background: #0f172a;
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 0 0 1px #334155;
    transition: transform 0.2s ease;
  }

  .card:hover {
    transform: translateY(-4px);
  }

  .card-title {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    color: #ffffff;
  }

  .card-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
  }

  .card-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #1e293b;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    color: #e2e8f0;
  }

  .card-icon {
    color: #38bdf8;
  }
</style>