---
import Card from "./Card.astro";
---

<section id="tecnologias" class="tecnologias">
  <h2>Stack Tecnológica</h2>
  <p class="sub">
    Tecnologias e práticas que utilizo em projetos profissionais, com foco em
    qualidade, performance e segurança.
  </p>

  <div class="tech-grid">
    <Card title="Frontend" icon="mdi:monitor">
      <div class="chips">
        <span>Angular</span>
        <span>React</span>
        <span>TypeScript</span>
        <span>JavaScript</span>
        <span>HTML5</span>
        <span>CSS3</span>
      </div>
    </Card>

    <Card title="Backend" icon="mdi:server">
      <div class="chips">
        <span>Java</span>
        <span>Node.js</span>
        <span>REST APIs</span>
        <span>Swagger / OpenAPI</span>
        <span>Maven</span>
      </div>
    </Card>

    <Card title="Banco de Dados" icon="mdi:database">
      <div class="chips">
        <span>SQL</span>
        <span>MongoDB</span>
      </div>
    </Card>

    <Card title="Ferramentas & Metodologias" icon="mdi:tools">
      <div class="chips">
        <span>Git</span>
        <span>GitHub</span>
        <span>SCRUM</span>
        <span>Kanban</span>
        <span>TDD</span>
        <span>Pair Programming</span>
      </div>
    </Card>

    <Card title="Mobile & Híbrido" icon="mdi:cellphone">
      <div class="chips">
        <span>React Native</span>
      </div>
    </Card>

    <Card title="Segurança" icon="mdi:shield-lock">
      <div class="chips">
        <span>API Security Fundamentals</span>
        <span>OWASP Top 10</span>
        <span>JWT</span>
        <span>RBAC</span>
      </div>
    </Card>
  </div>
</section>
