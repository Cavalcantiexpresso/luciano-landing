---
import { Icon } from "astro-icon";

const { title, icon } = Astro.props;
---

<div class="card">
  <div class="card-header">
    {icon && <Icon name={icon} class="card-icon" />}
    <h3>{title}</h3>
  </div>

  <div class="card-content">
    <slot />
  </div>
</div>

<style>
  .card {
    background: linear-gradient(180deg, #0d1526, #0b1020);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
    padding: 1rem;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.8rem;
  }

  .card-icon {
    font-size: 1.3rem;
    color: #5da9ff;
    transition:
      transform 0.25s ease,
      filter 0.25s ease;
  }

  .card:hover .card-icon {
    transform: scale(1.15);
    filter: drop-shadow(0 0 6px rgba(93, 169, 255, 0.6));
  }

  h3 {
    font-size: 1rem;
    font-weight: 600;
  }
</style>
