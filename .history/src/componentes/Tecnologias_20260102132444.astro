---
const frontend = [
  { name: "Angular", icon: "/icons/angular.svg" },
  { name: "React", icon: "/icons/react.svg" },
  { name: "TypeScript", icon: "/icons/typescript.svg" },
  { name: "JavaScript", icon: "/icons/javascript.svg" },
  { name: "HTML5", icon: "/icons/html5.svg" },
  { name: "CSS3 / SCSS", icon: "/icons/css3.svg" }
];

const backend = [
  { name: "Java", icon: "/icons/java.svg" },
  { name: "Node.js", icon: "/icons/nodejs.svg" },
  { name: "Express", icon: "/icons/express.svg" },
  { name: "Swagger (OpenAPI)", icon: "/icons/swagger.svg" },
  { name: "Maven", icon: "/icons/maven.svg" }
];

const database = [
  { name: "SQL", icon: "/icons/sql.svg" },
  { name: "MongoDB", icon: "/icons/mongodb.svg" }
];

const mobile = [
  { name: "Ionic", icon: "/icons/ionic.svg" },
  { name: "Capacitor", icon: "/icons/capacitor.svg" },
  { name: "React Native", icon: "/icons/react-native.svg" }
];
---

<section class="tech-section">
  <h2>Estou em constante evolução tecnológica</h2>
  <p>
    Ao longo de mais de 3 anos de experiência profissional, venho trabalhando
    com tecnologias consolidadas, aplicadas em sistemas corporativos,
    ambientes críticos e produtos reais.
  </p>

  <div class="tech-block">
    <h3>Tecnologias Frontend</h3>
    <div class="tech-list">
      {frontend.map(tech => (
        <div class="tech-item">
          <img src={tech.icon} alt={tech.name} />
          <span>{tech.name}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="tech-block">
    <h3>Tecnologias Backend</h3>
    <div class="tech-list">
      {backend.map(tech => (
        <div class="tech-item">
          <img src={tech.icon} alt={tech.name} />
          <span>{tech.name}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="tech-block">
    <h3>Bancos de Dados</h3>
    <div class="tech-list">
      {database.map(tech => (
        <div class="tech-item">
          <img src={tech.icon} alt={tech.name} />
          <span>{tech.name}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="tech-block">
    <h3>Mobile & Aplicações Híbridas</h3>
    <div class="tech-list">
      {mobile.map(tech => (
        <div class="tech-item">
          <img src={tech.icon} alt={tech.name} />
          <span>{tech.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.tech-section {
  max-width: 1200px;
  margin: auto;
  padding: 4rem 1rem;
}

.tech-section h2 {
  text-align: center;
  font-size: 2.2rem;
}

.tech-section p {
  text-align: center;
  max-width: 800px;
  margin: 1rem auto 3rem;
  opacity: 0.85;
}

.tech-block {
  margin-bottom: 3rem;
}

.tech-block h3 {
  margin-bottom: 1rem;
}

.tech-list {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem;
}

.tech-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  background: #1e293b;
  padding: 0.75rem 1rem;
  border-radius: 10px;
}

.tech-item img {
  width: 28px;
  height: 28px;
}
</style>
